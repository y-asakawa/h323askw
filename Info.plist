<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>h323askw</string>
    <key>CFBundleIdentifier</key>
    <string>com.h323askw.app</string>
    <key>CFBundleName</key>
    <string>H323ASKW</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>2.3.0</string>
    <key>CFBundleVersion</key>
    <string>2.3.0</string>
    
    <!-- カメラアクセス許可 -->
    <key>NSCameraUsageDescription</key>
    <string>H323 video calls require camera access for video communication with remote endpoints.</string>
    
    <!-- Continuityカメラサポート -->
    <key>NSCameraUseContinuityCameraDeviceType</key>
    <true/>
    
    <!-- マイクアクセス許可 -->
    <key>NSMicrophoneUsageDescription</key>
    <string>H323 audio calls require microphone access for voice communication.</string>

    <!-- ローカルネットワークアクセス許可 -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>H323ASKW needs access to the local network to connect to H.323 endpoints on your LAN.</string>

    <!-- Bonjourサービスを短時間広告してローカルネットワーク許可を前倒し -->
    <key>NSBonjourServices</key>
    <array>
        <string>_perm._tcp</string>
    </array>
    
    <!-- ネットワークアクセス -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
